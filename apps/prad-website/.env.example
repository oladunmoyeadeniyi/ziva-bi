# PRAD Marketing Website — Environment Variables
#
# This website has no server-side secrets. All configuration is done
# in src/lib/site.config.ts (pricing, copy, FAQ, app URLs).
#
# No environment variables are required to run this site.
# This file is kept as a placeholder in case analytics keys are added later.

# Optional: PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
